{
  "mcpServers": {
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" }
    },
    "fetch": {
      "command": "C:/miniconda/envs/writing-agent/python.exe",
      "args": ["-m", "mcp_server_fetch"],
      "env": {
        "HTTP_PROXY": "${LOCAL_PROXY}",
        "HTTPS_PROXY": "${LOCAL_PROXY}",
        "NO_PROXY": "127.0.0.1,localhost"
      }
    }
  }
}

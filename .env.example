# LLM 首次引导（OpenAI 兼容接口，默认 DeepSeek）：首次启动自动合成为项目根目录
# llm_providers.json 的 default 提供商；此后提供商/模型/温度经 Agent 面板切换并
# 持久化于该文件（已 gitignore，勿提交），本节变量仅作首次引导占位（架构 §5.4 v1.31）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_STREAM_TIMEOUT_SECONDS=300
TOOL_TIMEOUT_SECONDS=30
API_MAX_REQUEST_BODY_MB=520

# Tavily 搜索（tavily-mcp 使用；不配置则搜索工具不可用，系统仍可启动）
TAVILY_API_KEY=tvly-xxx

# 可选：fetch server 抓取网页使用的本机代理（config/mcp_servers.json 的 ${LOCAL_PROXY}；不设置则直连）
# LOCAL_PROXY=http://127.0.0.1:7890

# Agent Loop 最大步数（防死循环）
MAX_STEPS=25

# LLM 是否优先使用 response_format=json_object（部分兼容网关不支持时置 false）
LLM_JSON_MODE=true

# 运行锁 TTL（小时）：超时的锁行进入回收流程（配合 PID 存活校验，见 docs 架构 §4.6）
RUN_LOCK_TTL=2

# 阶段 4 项目导入上限
PROJECT_IMPORT_MAX_FILES=5000
PROJECT_IMPORT_MAX_TOTAL_MB=512
PROJECT_IMPORT_MAX_FILE_MB=100

# 项目 Agent 聊天上下文预算（架构 §3.3）
# 估算 token 超过预算时，把保留窗口之外的历史压缩成一段摘要并持久化复用；设为 0 关闭压缩
CHAT_CONTEXT_TOKEN_BUDGET=24000
# 永远全文保留的最近可见消息条数
CHAT_CONTEXT_KEEP_RECENT=8
# 注入 prompt 的当前文档正文字符上限，超出按首尾窗口截断
CHAT_CONTEXT_DOC_MAX_CHARS=12000

# 可选：覆盖 MCP 配置文件路径（默认 config/mcp_servers.json）
# MCP_SERVERS_JSON=config/mcp_servers.empty.json

# 聊天轮次终态选择性记忆沉淀（架构 §5.4 v1.30）；设为 false 关闭沉淀（记忆注入不受影响）
CHAT_MEMORY_CONSOLIDATION=true

# LLM（OpenAI 兼容接口，默认 DeepSeek）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Tavily 搜索（tavily-mcp 使用；不配置则搜索工具不可用，系统仍可启动）
TAVILY_API_KEY=tvly-xxx

# Agent Loop 最大步数（防死循环）
MAX_STEPS=25

# LLM 是否优先使用 response_format=json_object（部分兼容网关不支持时置 false）
LLM_JSON_MODE=true

# 运行锁 TTL（小时）：超时的锁行进入回收流程（配合 PID 存活校验，见 docs 架构 §4.6）
RUN_LOCK_TTL=2

# 阶段 4 项目导入上限
PROJECT_IMPORT_MAX_FILES=5000
PROJECT_IMPORT_MAX_TOTAL_MB=512
PROJECT_IMPORT_MAX_FILE_MB=100

# 可选：覆盖 MCP 配置文件路径（默认 config/mcp_servers.json）
# MCP_SERVERS_JSON=config/mcp_servers.empty.json
